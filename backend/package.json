{
  "name": "aqi-monitoring-backend",
  "version": "1.0.0",
  "description": "Backend API for Air Quality Monitoring System with user authentication and real-time AQI data",
  "main": "app.js",
  "scripts": {
    "start": "node app.js",
    "dev": "nodemon app.js",
    "ml-service": "cd ml && python app.py",
    "dev-all": "concurrently \"npm run dev\" \"npm run ml-service\"",
    "test": "echo \"Error: no test specified\" && exit 1",
    "test-ml": "cd ml && python test_integration.py"
  },
  "keywords": [
    "air-quality",
    "aqi",
    "monitoring",
    "nodejs",
    "express",
    "mongodb",
    "jwt",
    "authentication"
  ],
  "author": "AQI Monitoring Team",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.6.2",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^8.0.1",
    "express-validator": "^7.0.1",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.0.3",
    "morgan": "^1.10.0",
    "node-cron": "^4.2.1",
    "nodemailer": "^7.0.5",
    "twilio": "^5.8.0",
    "winston": "^3.17.0",
    "winston-daily-rotate-file": "^5.0.0"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "nodemon": "^3.0.2"
  },
  "engines": {
    "node": ">=16.0.0",
    "npm": ">=8.0.0"
  }
}
