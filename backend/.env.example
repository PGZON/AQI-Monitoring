# AQI Monitoring API - Environment Variables

# Database Configuration
MONGODB_URI=mongodb://localhost:27017/aqi-monitoring
# or use MongoDB Atlas: MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/aqi-monitoring

# JWT Configuration
JWT_SECRET=your-super-secure-jwt-secret-key-here-minimum-32-characters
JWT_EXPIRES_IN=7d

# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# Air Quality API Configuration
# OpenWeatherMap API (for current AQI data)
OPENWEATHER_API_KEY=your-openweathermap-api-key

# Alternative AQI APIs (choose one or multiple)
# IQAir API
IQAIR_API_KEY=your-iqair-api-key

# WAQI API (World Air Quality Index)
WAQI_API_TOKEN=your-waqi-token

# ML Service Configuration (for Phase 4)
ML_SERVICE_URL=http://localhost:5000
ML_SERVICE_ENABLED=true

# Email Notification Configuration (Phase 5)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-specific-password
EMAIL_FROM=noreply@aqimonitor.com

# SMS/WhatsApp Configuration (Phase 5) - Twilio
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1234567890
TWILIO_WHATSAPP_NUMBER=+14155238886

# Alternative SMS Providers (optional)
# AWS SNS
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key

# Nexmo/Vonage
NEXMO_API_KEY=your-nexmo-key
NEXMO_API_SECRET=your-nexmo-secret
NEXMO_FROM=YourAppName

# Alert Scheduler Configuration (Phase 5)
SCHEDULER_TIMEZONE=UTC
ALERT_CHECK_INTERVAL=30
FORECAST_CHECK_TIMES=08:00,18:00
CLEANUP_TIME=02:00

# Rate Limiting
ALERT_COOLDOWN_MINUTES=60
MAX_ALERTS_PER_DAY=50

# External Services Health Check
HEALTH_CHECK_INTERVAL=5

# Logging Configuration (Phase 7)
LOG_LEVEL=info
LOG_FILE_PATH=./logs/
LOG_MAX_SIZE=20m
LOG_MAX_FILES=14d
LOG_DATE_PATTERN=YYYY-MM-DD
LOG_ZIPPED_ARCHIVE=true

# Console Logging
CONSOLE_LOG_LEVEL=debug
CONSOLE_LOG_FORMAT=dev

# Error Tracking
ERROR_LOG_LEVEL=error
WARN_LOG_LEVEL=warn
EXCEPTION_HANDLING=true
REJECTION_HANDLING=true

# Request Logging
REQUEST_LOG_ENABLED=true
REQUEST_LOG_INCLUDE_BODY=false
REQUEST_LOG_INCLUDE_HEADERS=true
SLOW_REQUEST_THRESHOLD=1000

# Performance Monitoring
PERFORMANCE_LOG_ENABLED=true
MEMORY_MONITORING=true
CPU_MONITORING=true

# Frontend Configuration
FRONTEND_URL=http://localhost:3000

# Redis Configuration (optional - for caching)
REDIS_URL=redis://localhost:6379
REDIS_ENABLED=false

# Security Configuration
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
SESSION_SECRET=your-session-secret
BCRYPT_ROUNDS=12

# File Upload Configuration
MAX_FILE_SIZE=10mb
UPLOAD_PATH=./uploads

# API Rate Limiting
API_RATE_LIMIT_WINDOW=15m
API_RATE_LIMIT_MAX=100

# Development/Testing
DISABLE_AUTH=false
MOCK_EXTERNAL_APIS=false
TEST_EMAIL=test@example.com
TEST_PHONE=+1234567890
